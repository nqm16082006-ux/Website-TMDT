# ==========================================
# CẤU HÌNH APACHE .HTACCESS CHO WEBSITE TMDT
# ==========================================

# 1. Chặn truy cập trực tiếp vào các file nhạy cảm và cấu hình
<FilesMatch "^(\.env|\.env\.example|database\.sql|\.git|\.htaccess)">
    Order allow,deny
    Deny from all
</FilesMatch>

# 2. Tắt chế độ duyệt thư mục
Options -Indexes

# 3. Đảm bảo mã hóa UTF-8
AddDefaultCharset UTF-8

# 4. Cấu hình viết lại đường dẫn thân thiện (Rewrite Engine)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Bỏ qua nếu là file hoặc thư mục tĩnh thực tế (CSS, JS, Images, Uploads...)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Điều hướng trang Admin
    RewriteRule ^admin/?$ admin.php [L,QSA]
    RewriteRule ^admin/(.*)$ admin.php?act=$1 [L,QSA]

    # Điều hướng trang Khách hàng (User)
    RewriteRule ^cart/?$ index.php?act=cart [L,QSA]
    RewriteRule ^checkout/?$ index.php?act=checkout [L,QSA]
    RewriteRule ^products/?$ index.php?act=products [L,QSA]
    RewriteRule ^product/([0-9]+)/?$ index.php?act=product-detail&id=$1 [L,QSA]
    RewriteRule ^login/?$ index.php?act=login [L,QSA]
    RewriteRule ^register/?$ index.php?act=register [L,QSA]
    RewriteRule ^logout/?$ index.php?act=logout [L,QSA]
    RewriteRule ^profile/?$ index.php?act=profile [L,QSA]
    RewriteRule ^contact/?$ index.php?act=contact [L,QSA]
</IfModule>
